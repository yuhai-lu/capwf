{
  "welcomeFile": "/fiori-apps.html#Books-manage",
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/(fiori-apps\\.html|appconfig/[^?]*|admin-authors/[^?]*|admin-books/[^?]*|browse/[^?]*|genres/[^?]*)(?:\\?.*)?$",
      "target": "$1",
      "localDir": "resources"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "destination": "srv-api",
      "csrfProtection": true
    }
  ]
}
